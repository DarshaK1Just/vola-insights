# ── LLM (required) ───────────────────────────────────────────────────────────
# Get a free key at https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Data (optional) ───────────────────────────────────────────────────────────
# Absolute path to your transactions Excel/CSV file.
# If empty, a built-in 3-user demo dataset is used automatically.
DATA_FILE=

# ── Redis semantic cache (optional, recommended) ──────────────────────────────
# Serves identical/near-identical queries in < 1 ms by bypassing the LLM.
#
# Quick start:
#   Windows service:  already running if you followed setup (auto-starts on boot)
#   Docker:           docker run -d --name vola-redis -p 6379:6379 redis:7-alpine
#
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
# Seconds to cache a full LLM response (0 = disable response caching)
RESPONSE_CACHE_TTL=3600

# ── API server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*

# ── Frontend ──────────────────────────────────────────────────────────────────
API_URL=http://localhost:8000

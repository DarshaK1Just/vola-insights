# ── LLM (required) ───────────────────────────────────────────────────────────
# Get a free key at https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Data (optional) ───────────────────────────────────────────────────────────
# Absolute path to your transactions Excel/CSV file.
# If empty, a built-in 3-user demo dataset is used automatically.
DATA_FILE=

# ── Redis semantic cache (optional but recommended) ────────────────────────
# Streamlit Cloud: Use Redis Cloud (https://app.redislabs.com/try-free)
# Local dev:       docker run -d --name redis -p 6379:6379 redis:7-alpine
#
# Connection format: redis://default:PASSWORD@HOST:PORT
# Replace with your actual Redis URL (keep the full string including default: and password)
# Example: redis://default:abc123@redis-12345.c123.us-east-1-2.ec2.cloud.redis.io:6379
#
# Leave empty to disable (uses diskcache fallback — slower but works everywhere)
REDIS_URL=redis://default:37kQYZkr3qxmpCCyMaAN2vKwQ00e85Gz@gauze-voluptuous-chess-36371.db.redis.io:19948
REDIS_ENABLED=true
# Seconds to cache a full LLM response (0 = disable response caching)
RESPONSE_CACHE_TTL=3600

# ── API server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*

# ── Frontend ──────────────────────────────────────────────────────────────────
API_URL=http://localhost:8000
